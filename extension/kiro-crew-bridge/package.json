{
  "name": "kiro-crew-bridge",
  "displayName": "Kiro Crew Bridge",
  "description": "Connects this VS Code to the Kiro Crew vscode-pane app: makes Kiro Crew a native chat session type (streaming replies, tool cards, approvals and history from Kiro Crew chat sessions), keeps a default participant as the fallback, applies the Kiro Crew colour theme, opens files Kiro Crew asks for and reports the active editor back.",
  "version": "0.5.2",
  "publisher": "kiro-crew",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatProvider"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "kiro-crew.default",
        "name": "kirocrew-default",
        "fullName": "Kiro Crew",
        "description": "Ask Kiro Crew; the turn runs as a Kiro Crew chat session for this folder",
        "isDefault": true,
        "isSticky": true,
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      },
      {
        "id": "kiro-crew.agent",
        "name": "kirocrew",
        "fullName": "Kiro Crew",
        "description": "Ask Kiro Crew; the turn runs as a Kiro Crew chat session for this folder",
        "isSticky": true
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "kiro-crew",
        "displayName": "Kiro Crew"
      },
      {
        "vendor": "kirocrew",
        "displayName": "Kiro Crew (session)"
      }
    ],
    "commands": [
      {
        "command": "kiroCrewBridge.showStatus",
        "title": "Kiro Crew: Show Bridge Status"
      },
      {
        "command": "kiroCrew.openCrewChat",
        "title": "Kiro Crew: Open Crew Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kiroCrew.toggleCrewChat",
        "title": "Kiro Crew: Open Crew Chat (0.4.0 id)"
      },
      {
        "command": "kiroCrew.connect",
        "title": "Kiro Crew: Connect the Kiro Crew Tab"
      },
      {
        "command": "kiroCrew.disconnect",
        "title": "Kiro Crew: Disconnect the Kiro Crew Tab",
        "icon": "$(debug-disconnect)"
      }
    ],
    "chatSessions": [
      {
        "type": "kirocrew",
        "name": "kirocrew",
        "displayName": "Kiro Crew",
        "description": "Chat with Kiro Crew: each chat is a Kiro Crew session with its agents, tools and approvals",
        "canDelegate": true,
        "requiresCopilotSignIn": false,
        "requiresCustomModels": true,
        "supportsAutoModel": false,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsPromptAttachments": true
        },
        "welcomeTitle": "Kiro Crew",
        "welcomeMessage": "Each chat here is a Kiro Crew session for this folder. Its replies, tools and approvals come from Kiro Crew, and it also shows in the Kiro Crew sidebar.",
        "inputPlaceholder": "Ask Kiro Crew",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "keybindings": [
      {
        "command": "kiroCrew.openCrewChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kiroCrew.openCrewChat",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "kiroCrew.toggleCrewChat",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "kiroCrew.disconnect",
          "when": "view == kiroCrew.chatView",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Kiro Crew",
      "properties": {
        "kiroCrew.chat.hideCopilotAgents": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Make Kiro Crew the default for new chats by hiding Copilot's own agents (the local Ask/Agent harness, Cloud and Copilot CLI) from the session-type picker. Turn off to bring them back; Kiro Crew sessions stay available either way."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "kiroCrew",
          "title": "Kiro Crew",
          "icon": "media/kiro-crew.svg"
        }
      ]
    },
    "views": {
      "kiroCrew": [
        {
          "type": "webview",
          "id": "kiroCrew.chatView",
          "name": "Kiro Crew",
          "icon": "media/kiro-crew.svg",
          "contextualTitle": "Kiro Crew"
        }
      ]
    }
  }
}
