{
  "name": "vscode-pane",
  "version": "0.5.1",
  "displayName": "VS Code",
  "description": "A full VS Code in a Kiro Crew pane. The app runs the official VS Code server on this machine and shows its workbench in the page, themed from Kiro Crew's palette, with a bridge so Kiro Crew can open files in VS Code and see which file VS Code has open, and a VS Code button in the chat composer that opens the chat's project folder.",
  "author": "John Chapman",
  "license": "MIT",
  "minKiroCrewVersion": "0.13.0",
  "tags": [
    "code",
    "editor",
    "vscode",
    "files"
  ],
  "defaultEnabled": false,
  "platform": {
    "os": [
      "windows",
      "macos",
      "linux"
    ],
    "requiresDesktopApp": true
  },
  "iconPath": "assets/icon-flat.svg",
  "permissions": {
    "api": [
      "/apps/vscode-pane/api",
      "/api/recent-projects",
      "/api/chat",
      "/api/chat/slots",
      "/api/status"
    ],
    "sessionApproval": true
  },
  "backend": {
    "type": "node",
    "entryPoint": "backend/launcher.mjs",
    "port": "auto",
    "healthCheck": "/health"
  },
  "ui": {
    "entry": "vscode-pane-0.5.1.mjs",
    "pages": [
      {
        "route": "/apps/vscode-pane",
        "label": "VS Code",
        "iconUrl": "icon-mono.svg",
        "iconInactiveUrl": "icon-idle.svg"
      }
    ]
  },
  "contributes": {
    "fileMenuItems": [
      {
        "id": "open-in-vscode",
        "label": "Open in VS Code",
        "icon": "Zap",
        "endpoint": "/apps/vscode-pane/api/file-menu",
        "surfaces": [
          "file-overflow",
          "tree-context",
          "folder-row"
        ],
        "when": {
          "kinds": [
            "file",
            "dir"
          ]
        }
      }
    ],
    "sessionControls": [
      {
        "id": "open-in-vscode",
        "entryPoint": "vscode-pane-session-0.5.1.mjs",
        "label": "VS Code",
        "icon": "Package"
      }
    ]
  }
}
