{
  "name": "vscode-pane",
  "version": "0.7.0",
  "displayName": "Visual Studio Code Server Integration",
  "description": "A full Visual Studio Code in a Kiro Crew pane. The app runs the official Visual Studio Code server on this machine and shows its workbench in the page, themed from Kiro Crew's palette, with a bridge so Kiro Crew can open files in Visual Studio Code and see which file Visual Studio Code has open, and an Open in Code button in the chat composer that opens the chat's project folder.",
  "author": "John Chapman",
  "license": "MIT",
  "minKiroCrewVersion": "0.13.0",
  "tags": [
    "code",
    "editor",
    "vscode",
    "files"
  ],
  "defaultEnabled": false,
  "platform": {
    "os": [
      "windows",
      "macos",
      "linux"
    ],
    "requiresDesktopApp": true
  },
  "iconPath": "assets/icon-blue.svg",
  "heroImage": "assets/store-hero.svg",
  "heroImageDetail": "assets/store-hero-detail.svg",
  "permissions": {
    "api": [
      "/apps/vscode-pane/api",
      "/api/recent-projects",
      "/api/chat",
      "/api/chat/slots",
      "/api/status"
    ],
    "sessionApproval": true
  },
  "backend": {
    "type": "node",
    "entryPoint": "backend/launcher.mjs",
    "port": "auto",
    "healthCheck": "/health",
    "webOrigin": true
  },
  "ui": {
    "entry": "vscode-pane-0.7.0.mjs",
    "pages": [
      {
        "route": "/apps/vscode-pane",
        "label": "Code",
        "iconUrl": "icon-mono.svg",
        "iconInactiveUrl": "icon-idle.svg"
      }
    ]
  },
  "contributes": {
    "fileMenuItems": [
      {
        "id": "open-in-vscode",
        "label": "Open in VS Code",
        "icon": "Zap",
        "endpoint": "/apps/vscode-pane/api/file-menu",
        "surfaces": [
          "file-overflow",
          "tree-context",
          "folder-row"
        ],
        "when": {
          "kinds": [
            "file",
            "dir"
          ]
        }
      }
    ],
    "sessionControls": [
      {
        "id": "open-in-vscode",
        "entryPoint": "vscode-pane-session-0.7.0.mjs",
        "label": "Open in Code",
        "icon": "Package"
      }
    ]
  }
}
